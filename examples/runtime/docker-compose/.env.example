# iac-cartographer .env for the docker-compose example.
#
# Copy to `.env` and replace REPLACE_ME-... with real values. Mode 0600
# is strongly recommended:
#   cp .env.example .env
#   chmod 600 .env
#
# The naming convention (IAC_CARTOGRAPHER_SECRET_<NAME>) is the env
# secrets backend's mangling rule:
#   `iac-cartographer/confluence` → IAC_CARTOGRAPHER_SECRET_CONFLUENCE
# Values for SECRET_* must be JSON-encoded; PARAM_* are plain strings.

# Confluence Cloud API credentials. Use a legacy unscoped token (the
# plain "Create API token" form at id.atlassian.com).
IAC_CARTOGRAPHER_SECRET_CONFLUENCE={"email":"REPLACE_ME-bot@example.com","api_token":"REPLACE_ME-ATATT..."}

# GitLab personal access token with `read_api` scope.
IAC_CARTOGRAPHER_SECRET_GITLAB={"token":"REPLACE_ME-glpat-..."}

# GitHub personal access token with `repo` scope on the orgs you scan.
IAC_CARTOGRAPHER_SECRET_GITHUB={"token":"REPLACE_ME-ghp_..."}

# Slack bot token. The notifier handles 200 + ok:false gracefully, so a
# fake value here doesn't break the run — it just means no Slack post.
IAC_CARTOGRAPHER_SECRET_SLACK={"bot_token":"REPLACE_ME-xoxb-..."}

# Anthropic API key (matches llm.backend: anthropic in config.yaml).
IAC_CARTOGRAPHER_SECRET_ANTHROPIC={"api_key":"REPLACE_ME-sk-ant-..."}

# Confluence parent page ID. Only needed when publisher.kind is
# "confluence" AND you didn't set confluence.parent_page_id directly
# in config.yaml. The default config.yaml here uses the markdown
# publisher, so this line is optional.
# IAC_CARTOGRAPHER_PARAM_CONFLUENCE_PARENT_ID=REPLACE_ME-123456789
